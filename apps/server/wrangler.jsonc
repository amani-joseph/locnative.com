{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "locnative-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-14",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env"
	],
	"dev": { "ip": "0.0.0.0", "port": 3003 },
	"routes": [
		{
			"pattern": "api.locnative.com",
			"custom_domain": true
		}
	],
	"vars": {
		"AUTH_COOKIE_DOMAIN": ".locnative.com",
		"BETTER_AUTH_URL": "https://api.locnative.com",
		"WEB_BASE_URL": "https://locnative.com"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"queues": {
		"producers": [
			{ "queue": "locnative-batch-geocode", "binding": "BATCH_GEOCODE_QUEUE" },
			{ "queue": "locnative-webhook-delivery", "binding": "WEBHOOK_DELIVERY_QUEUE" }
		],
		"consumers": [
			{ "queue": "locnative-batch-geocode", "max_batch_size": 10 },
			{ "queue": "locnative-webhook-delivery", "max_batch_size": 5 }
		]
	},
	"r2_buckets": [
		{ "binding": "GEOCODE_RESULTS", "bucket_name": "locnative-geocode-results" },
		{ "binding": "MAP_TILES", "bucket_name": "locnative-tiles" }
	],
	"durable_objects": {
		"bindings": [{ "name": "USAGE_METER", "class_name": "UsageMeter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageMeter"] }]
}
