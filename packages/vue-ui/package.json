{
  "name": "@locnative/vue-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Production-ready Vue 3 components for Locnative SDK — address autocomplete, geocoding, and form fields with accessibility and customization.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node scripts/build-css.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "lint:pkg": "publint && attw --pack --exclude-entrypoints ./styles.css",
    "prepublishOnly": "pnpm build && pnpm lint:pkg"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "peerDependencies": {
    "@locnative/sdk": ">=0.1.0",
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@vitejs/plugin-vue": "^5.1.4",
    "publint": "^0.3.21",
    "@locnative/sdk": "workspace:*",
    "typescript": "^5.4.4",
    "vite": "^5.1.6",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^1.2.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.2.12"
  }
}
