{
  "name": "@locnative/react",
  "version": "0.1.0",
  "description": "React hooks for the Locnative location API",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18",
    "@locnative/sdk": ">=0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@types/react": "^19",
    "@locnative/config": "workspace:*",
    "publint": "^0.3.21",
    "react": "catalog:",
    "@locnative/sdk": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint:pkg": "publint && attw --pack",
    "prepublishOnly": "pnpm build && pnpm lint:pkg"
  }
}
