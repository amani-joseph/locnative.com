{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "locnative-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-14",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env"
	],
	"dev": { "ip": "0.0.0.0", "port": 3003 },
	"routes": [
		{
			"pattern": "api.locnative.com",
			"custom_domain": true
		}
	],
	"vars": {
		"AUTH_COOKIE_DOMAIN": ".locnative.com",
		"BETTER_AUTH_URL": "https://api.locnative.com",
		"WEB_BASE_URL": "https://locnative.com",
		// Neon usage monitor. Secrets set separately: NEON_API_KEY (org API
		// key) and NEON_MONITOR_DISCORD_WEBHOOK_URL.
		"NEON_ORG_ID": "org-patient-leaf-57488846",
		"NEON_MONITOR_ALERT_EMAIL": "chirurecode@gmail.com"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	"triggers": {
		// Daily Stripe usage report (yesterday's final totals). Hourly kept Neon
		// awake ~24 wakes/day pre-launch — see docs/audits/neon-compute-audit-2026-09-30.md.
		// Hourly at :30: Neon usage monitor (Neon API only; never touches Postgres).
		"crons": ["10 0 * * *", "30 * * * *"]
	},
	"queues": {
		"producers": [
			{ "queue": "locnative-batch-geocode", "binding": "BATCH_GEOCODE_QUEUE" },
			{ "queue": "locnative-webhook-delivery", "binding": "WEBHOOK_DELIVERY_QUEUE" }
		],
		"consumers": [
			{ "queue": "locnative-batch-geocode", "max_batch_size": 10 },
			{ "queue": "locnative-webhook-delivery", "max_batch_size": 5 }
		]
	},
	"r2_buckets": [
		{ "binding": "GEOCODE_RESULTS", "bucket_name": "locnative-geocode-results" },
		{ "binding": "MAP_TILES", "bucket_name": "locnative-tiles" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "USAGE_METER", "class_name": "UsageMeter" },
			{ "name": "NEON_MONITOR", "class_name": "NeonMonitor" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["UsageMeter"] },
		{ "tag": "v2", "new_sqlite_classes": ["NeonMonitor"] }
	]
}
