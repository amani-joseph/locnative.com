{
  "name": "@locnative/react-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Production-ready React components for Locnative SDK — address autocomplete, geocoding, and form fields with accessibility and customization.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint && attw --pack --exclude-entrypoints ./styles.css",
    "prepublishOnly": "pnpm build && pnpm lint:pkg",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "@locnative/sdk": ">=0.1.0",
    "@locnative/react": ">=0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@locnative/react": "workspace:*",
    "@locnative/sdk": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jsdom": "^23.0.1",
    "publint": "^0.3.21",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^9.0.0",
    "tailwind-merge": "^2.3.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.4",
    "vite": "^7.0.2",
    "vitest": "^1.2.0"
  }
}
